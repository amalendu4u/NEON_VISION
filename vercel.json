{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/player", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/docs/:path*", "destination": "/index.html" },
    { "source": "/workbench", "destination": "/workbench.html" }
  ]
}
